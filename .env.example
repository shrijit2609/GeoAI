# Copy to .env and adjust. Never commit a real .env.

# Absolute or relative path to the directory that holds the trained artifacts.
# Defaults to <repo>/models when unset.
MODEL_ROOT=./models

# auto | cpu | cuda
SPATIALSHIFT_DEVICE=auto

SPATIALSHIFT_ENVIRONMENT=development
SPATIALSHIFT_LOG_LEVEL=INFO
SPATIALSHIFT_API_PREFIX=/api
SPATIALSHIFT_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
SPATIALSHIFT_ULPIN_ENDPOINT=
SPATIALSHIFT_FRONTEND_ROOT=./frontend

# Load every checkpoint at startup instead of on first use (off by default).
SPATIALSHIFT_EAGER_MODEL_LOAD=false
